#!/bin/bash

PROJECT_DIR="$HOME/station-dashboard"
SERVICE="station-dashboard.service"
VERSION="v2.4.0"

show_help() {
cat << EOF

=========================================
 James City Bruton VFD Dashboard
 Maintenance Utility
=========================================

Usage:

    ./tools/dashboardctl <command>

Commands:

    status
        Display dashboard status

    stop
        Stop the dashboard and Chromium

    start
        Start Chromium and the dashboard

    restart
        Restart the dashboard

    health MMDDYY HHMM MMDDYY HHMM
        Run a detailed health analysis for a specific time period

    version
        Display dashboard version

    help
        Display this help screen

EOF
}

status() {

    HOSTNAME=$(hostname)

    if systemctl is-active --quiet "$SERVICE"; then
        DASHBOARD_STATUS="Running"
    else
        DASHBOARD_STATUS="Stopped"
    fi

    # Chromium check
    if pgrep -af chromium >/dev/null; then
        CHROMIUM_STATUS="Running"
    else
        CHROMIUM_STATUS="Stopped"
    fi

cat << EOF

=========================================
 James City Bruton VFD Dashboard
 Maintenance Utility
=========================================

Host:               $HOSTNAME
Dashboard Service:  $DASHBOARD_STATUS
Chromium:           $CHROMIUM_STATUS
Version:            $VERSION

EOF
}

stop_dashboard() {

    echo "Stopping dashboard..."
    sudo systemctl stop "$SERVICE"

    echo "Stopping Chromium..."
    pkill chromium >/dev/null 2>&1

    echo
    echo "Maintenance mode enabled."
}

start_dashboard() {

    echo "Starting Chromium..."

    env DISPLAY=:0 \
        WAYLAND_DISPLAY=wayland-0 \
        XDG_RUNTIME_DIR=/run/user/1000 \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
        XDG_SESSION_TYPE=wayland \
        systemd-run --user --scope \
        "$PROJECT_DIR/scripts/start-browser.sh" >/tmp/station-dashboard-chromium.log 2>&1 &

    echo "Waiting for Chromium..."
    sleep 5

    echo "Starting dashboard..."
    sudo systemctl start "$SERVICE"

    echo
    echo "Production mode enabled."
}


restart_dashboard() {

    echo "Restarting dashboard..."
    sudo systemctl restart "$SERVICE"

    echo
    echo "Dashboard restarted."
}


health() {

    if [ "$#" -ne 4 ]; then
        echo
        echo "Usage:"
        echo "  ./tools/dashboardctl health MMDDYY HHMM MMDDYY HHMM"
        echo
        echo "Example:"
        echo "  ./tools/dashboardctl health 082526 1400 082526 1900"
        echo
        return 1
    fi

    if ! [[ "$1" =~ ^[0-9]{6}$ &&
            "$2" =~ ^[0-9]{4}$ &&
            "$3" =~ ^[0-9]{6}$ &&
            "$4" =~ ^[0-9]{4}$ ]]; then
        echo
        echo "ERROR: Invalid date/time format."
        echo "Expected: MMDDYY HHMM MMDDYY HHMM"
        echo
        return 1
    fi

    if ! python3 - "$1" "$2" "$3" "$4" <<'PYVALID'
from datetime import datetime
import sys

try:
    start = datetime.strptime(sys.argv[1] + sys.argv[2], "%m%d%y%H%M")
    end = datetime.strptime(sys.argv[3] + sys.argv[4], "%m%d%y%H%M")
except ValueError:
    print("ERROR: Invalid date/time period.")
    print("Check the date and time values.")
    sys.exit(1)

if end <= start:
    print("ERROR: Invalid date/time period.")
    print("The end time must be later than the start time.")
    sys.exit(1)
PYVALID
    then
        return 1
    fi

    echo
    echo "Running health analysis..."
    echo "Period: $1 $2 → $3 $4"
    echo

    python3 "$PROJECT_DIR/tools/analyze-daily-log.py" \
        --period "$1" "$2" "$3" "$4"
}


version() {

    echo
    echo "Dashboard Version: $VERSION"
    echo
}

case "$1" in
    status)
        status
        ;;
    stop)
        stop_dashboard
        ;;
    start)
        start_dashboard
        ;;
    restart)
        restart_dashboard
        ;;
    health)
        shift
        health "$@"
        ;;
    version)
        version
        ;;
    help|"")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac
