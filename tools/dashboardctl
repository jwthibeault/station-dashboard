#!/bin/bash

PROJECT_DIR="$HOME/station-dashboard"
SERVICE="station-dashboard.service"
VERSION="v2.2.0"

show_help() {
cat << EOF

=========================================
 James City Bruton VFD Dashboard
 Maintenance Utility
=========================================

Usage:

    ./tools/dashboardctl <command>

Commands:

    status
        Display dashboard status

    maintenance
        Stop the dashboard and Chromium

    production
        Start Chromium and the dashboard

    restart
        Restart the dashboard

    v2-status
        Display V2 development dashboard status

    v2-stop
        Stop V2 development dashboard and its Chromium windows

    v2-start
        Start V2 development dashboard

    v2-restart
        Restart V2 development dashboard

    version
        Display dashboard version

    help
        Display this help screen

EOF
}

status() {

    HOSTNAME=$(hostname)

    if systemctl is-active --quiet "$SERVICE"; then
        DASHBOARD_STATUS="Running"
    else
        DASHBOARD_STATUS="Stopped"
    fi

    # Chromium check
    if pgrep -af chromium >/dev/null; then
        CHROMIUM_STATUS="Running"
    else
        CHROMIUM_STATUS="Stopped"
    fi

cat << EOF

=========================================
 James City Bruton VFD Dashboard
 Maintenance Utility
=========================================

Host:               $HOSTNAME
Dashboard Service:  $DASHBOARD_STATUS
Chromium:           $CHROMIUM_STATUS
Version:            $VERSION

EOF
}

maintenance() {

    echo "Stopping dashboard..."
    sudo systemctl stop "$SERVICE"

    echo "Stopping Chromium..."
    pkill chromium >/dev/null 2>&1

    echo
    echo "Maintenance mode enabled."
}

production() {

    echo "Starting Chromium..."

    env DISPLAY=:0 \
        WAYLAND_DISPLAY=wayland-0 \
        XDG_RUNTIME_DIR=/run/user/1000 \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
        XDG_SESSION_TYPE=wayland \
        systemd-run --user --scope \
        "$PROJECT_DIR/scripts/start-browser.sh" >/tmp/station-dashboard-chromium.log 2>&1 &

    echo "Waiting for Chromium..."
    sleep 5

    echo "Starting dashboard..."
    sudo systemctl start "$SERVICE"

    echo
    echo "Production mode enabled."
}


restart_dashboard() {

    echo "Restarting dashboard..."
    sudo systemctl restart "$SERVICE"

    echo
    echo "Dashboard restarted."
}

v2_status() {

    echo
    echo "========================================="
    echo " V2 Development Dashboard Status"
    echo "========================================="

    for port in 9230 9231 9232 9233; do
        if curl -s --max-time 1 \
            "http://127.0.0.1:${port}/json/version" \
            >/dev/null 2>&1; then
            echo "CDP $port:              Running"
        else
            echo "CDP $port:              Stopped"
        fi
    done

    if ss -ltn 2>/dev/null | grep -q ':8082 '; then
        echo "V2 wrapper server:      Running"
    else
        echo "V2 wrapper server:      Stopped"
    fi

    if pgrep -af 'v2/start-dashboard.py' >/dev/null; then
        echo "V2 dashboard process:   Running"
    else
        echo "V2 dashboard process:   Stopped"
    fi

    echo
}


v2_stop() {

    echo "Stopping V2 dashboard..."

    pkill -f 'v2/start-dashboard.py' >/dev/null 2>&1 || true

    echo "Stopping V2 Chromium windows..."

    for profile in \
        /tmp/v2-bloomwx-profile \
        /tmp/v2-vdot-profile \
        /tmp/v2-iamresponding-profile \
        /tmp/v2-pulsepoint-profile
    do
        pkill -f "$profile" >/dev/null 2>&1 || true
    done

    echo "Stopping V2 wrapper server..."
    fuser -k 8082/tcp >/dev/null 2>&1 || true

    sleep 2

    echo
    echo "V2 development dashboard stopped."
}


v2_start() {

    echo "Starting V2 development dashboard..."

    cd "$PROJECT_DIR" || exit 1

    source venv/bin/activate

    python3 -u v2/start-dashboard.py \
        >/tmp/v2-start-dashboard.log 2>&1 &

    echo
    echo "V2 development dashboard starting."
    echo "Log: /tmp/v2-start-dashboard.log"
}


v2_restart() {

    echo "Restarting V2 development dashboard..."

    v2_stop
    sleep 2
    v2_start
}


version() {

    echo
    echo "Dashboard Version: $VERSION"
    echo
}

case "$1" in
    status)
        status
        ;;
    maintenance)
        maintenance
        ;;
    production)
        production
        ;;
    restart)
        restart_dashboard
        ;;
    v2-status)
        v2_status
        ;;
    v2-stop)
        v2_stop
        ;;
    v2-start)
        v2_start
        ;;
    v2-restart)
        v2_restart
        ;;
    version)
        version
        ;;
    help|"")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac
